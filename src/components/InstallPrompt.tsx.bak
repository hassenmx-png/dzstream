import { useEffect, useState } from 'react'
import { Download, X, Share } from 'lucide-react'

interface BeforeInstallPromptEvent extends Event {
  prompt: () => Promise<void>
  userChoice: Promise<{ outcome: 'accepted' | 'dismissed' }>
}

const DISMISS_KEY = 'novastream:install-dismissed'
const isIos = () => /iphone|ipad|ipod/i.test(navigator.userAgent)
const isStandalone = () =>
  window.matchMedia('(display-mode: standalone)').matches ||
  (navigator as unknown as { standalone?: boolean }).standalone === true

/**
 * Bannière d'installation PWA. Android/Chrome : événement natif
 * beforeinstallprompt → bouton « Installer ». iOS : pas d'événement, on
 * affiche le mode d'emploi (Partager → Sur l'écran d'accueil). Masquée si
 * l'app tourne déjà en mode installé ou si l'utilisateur a dit non.
 */
export function InstallPrompt() {
  const [deferred, setDeferred] = useState<BeforeInstallPromptEvent | null>(null)
  const [visible, setVisible] = useState(false)
  const [ios, setIos] = useState(false)

  useEffect(() => {
    if (isStandalone()) return
    try {
      if (localStorage.getItem(DISMISS_KEY)) return
    } catch { /* ignore */ }

    const onPrompt = (e: Event) => {
      e.preventDefault()
      setDeferred(e as BeforeInstallPromptEvent)
      setVisible(true)
    }
    window.addEventListener('beforeinstallprompt', onPrompt)
    // iOS ne déclenche jamais l'événement : on montre la bannière
    // d'instructions après un court délai.
    const t = setTimeout(() => {
      if (isIos()) {
        setIos(true)
        setVisible(true)
      }
    }, 8000)
    return () => {
      window.removeEventListener('beforeinstallprompt', onPrompt)
      clearTimeout(t)
    }
  }, [])

  if (!visible) return null

  const install = async () => {
    if (!deferred) return
    await deferred.prompt()
    const { outcome } = await deferred.userChoice
    if (outcome === 'accepted') setVisible(false)
    setDeferred(null)
  }

  const dismiss = () => {
    setVisible(false)
    try { localStorage.setItem(DISMISS_KEY, '1') } catch { /* ignore */ }
  }

  return (
    <div className="fixed bottom-4 inset-x-4 z-[70] mx-auto max-w-md rounded-md border border-[rgb(var(--acc))]/30 bg-[#0a0a0a]/95 backdrop-blur p-4 shadow-2xl rise-in">
      <div className="flex items-start gap-3">
        <img src="/icons/icon-192.png" alt="" className="h-10 w-10 rounded-md" />
        <div className="min-w-0 flex-1">
          <p className="text-sm font-bold">Installe DZ STREAM</p>
          {ios ? (
            <p className="mt-0.5 text-xs text-white/55 leading-relaxed flex items-center gap-1 flex-wrap">
              Touche <Share size={12} className="inline text-[rgb(var(--acc))]" /> « Partager » puis
              « Sur l'écran d'accueil » pour avoir l'app en plein écran.
            </p>
          ) : (
            <p className="mt-0.5 text-xs text-white/55 leading-relaxed">
              Icône sur ton écran d'accueil, plein écran, démarrage instantané.
            </p>
          )}
        </div>
        <button onClick={dismiss} className="p-1 text-white/40 hover:text-white" aria-label="Fermer">
          <X size={16} />
        </button>
      </div>
      {!ios && (
        <button
          onClick={() => void install()}
          className="mt-3 w-full flex items-center justify-center gap-2 rounded-sm bg-[rgb(var(--acc))] py-2.5 text-sm font-bold text-white hover:scale-[1.01] active:scale-95 transition-transform"
        >
          <Download size={16} /> Installer l'application
        </button>
      )}
    </div>
  )
}
